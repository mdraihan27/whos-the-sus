# ---------------------------------------------------------------------------
# 1. Firebase web app config
# Firebase console -> Project settings -> Your apps -> Web app.
# These are public by design (they identify the project, they don't authorize
# it); access is controlled by the rules in `firestore.rules`.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# 2. Service account key  -- SECRET, never commit or expose to the browser
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key. Paste the whole downloaded JSON on ONE line inside single quotes.
#
# The server uses this to deal out imposters and words. It has to be
# server-side: anything the browser can read, a player can read too.
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}'
